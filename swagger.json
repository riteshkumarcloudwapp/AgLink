      "summary": "Delete Category",
      "description": "Delete a category by ID",
      "tags": ["HOME"],
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "description": "Category ID",
          "schema": {
            "type": "string",
            "example": "uuid"
          }
        }
      ],
      "responses": {
        "200": {
          "description": "Category deleted successfully",
          "content": {
            "application/json": {
              "example": {
                "status": true,
