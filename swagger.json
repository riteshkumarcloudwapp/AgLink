     "/user/role-change": {
    "post": {
    "summary": "Change User Role",
    "description": "Toggle authenticated user role between customer and seller",
    "tags": ["USER"],

    "security": [
      {
        "BearerAuth": []
      }
    ],

    "responses": {

      "200": {
        "description": "Role changed successfully",
        "content": {
          "application/json": {
            "examples": {

              "changedToSeller": {
                "value": {
                  "status": true,
                  "message": "Role changed to seller"
                }
              },

              "changedToCustomer": {
                "value": {
                  "status": true,
                  "message": "Role changed to customer"
                }
              }

            }
          }
        }
      },

      "400": {
        "description": "User not found",
        "content": {
          "application/json": {
            "example": {
              "status": false,
              "message": "User not found"
            }
          }
        }
      },

      "401": {
        "description": "Unauthorized",
        "content": {
          "application/json": {
            "example": {
              "status": false,
              "message": "Authentication failed. No token provided."
            }
          }
        }
      },

      "500": {
        "description": "Internal Server Error",
        "content": {
          "application/json": {
            "example": {
              "status": false,
              "message": "Something went wrong"
            }
          }
        }
      }

    }
  }
