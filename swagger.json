      "post": {
        "summary": "Add Variety",
        "description": "Create a new variety with image upload",
        "tags": ["HOME"],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["name", "sub_category_id", "image"],
                "properties": {
                  "name": {
                    "type": "string",
                    "example": "Tomato"
                  },
                  "sub_category_id": {
                    "type": "string",
                    "format": "uuid",
                    "example": "05fabc5a-3bc2-4338-bd16-53fef1e9b4a0"
