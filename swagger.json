{
    "openapi": "3.0.2",
    "info": {
        "title": "My Express API",
        "description": "A sample API built with Express",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://localhost:3000"
        }
    ],
    "security": [],
    "paths": {

    "/user/register": {
    "post": {
    "summary": "Register User",
    "description": "Registers a new user with email and phone number. Sends OTP to email after successful registration.",
    "tags": ["USER AUTH"],
    "requestBody": {
      "required": true,
      "content": {
        "application/json": {
          "schema": {
            "type": "object",
            "required": [
              "first_name",
              "last_name",
              "email",
              "country_code",
              "phone_number",
              "password"
            ],
            "properties": {
              "first_name": {
                "type": "string",
                "example": "Ritesh"
              },
              "last_name": {
                "type": "string",
                "example": "Kumar"
              },
              "email": {
                "type": "string",
                "format": "email",
                "example": "ritesh@gmail.com"
              },
              "country_code": {
                "type": "string",
                "example": "+91"
              },
              "phone_number": {
                "type": "string",
                "example": "9876543210"
              },
              "password": {
                "type": "string",
                "example": "123456"
              }
            }
          }
        }
      }
    },
    "responses": {
      "200": {
        "description": "OTP sent to registered email",
        "content": {
          "application/json": {
            "example": {
              "status": true,
              "message": "Otp sent to Registered Email",
              "data": {
                "id": "uuid",
                "first_name": "Ritesh",
                "last_name": "Kumar",
                "email": "ritesh@gmail.com",
                "country_code": "+91",
                "phone_number": "9876543210",
                "otp": "123456",
                "expiry_time": "2026-05-01T10:00:00Z"
              }
            }
          }
        }
      },
      "400": {
        "description": "User already exists or validation error",
        "content": {
          "application/json": {
            "example": {
              "status": false,
              "message": "Email or Phone_number already Registered"
            }
          }
        }
      },
      "500": {
        "description": "Internal Server Error",
        "content": {
          "application/json": {
            "example": {
              "status": false,
              "message": "Something went wrong"
            }
          }
        }
      }
    }
  }
     },
    "/user/verify-otp": {
    "post": {
    "summary": "Verify OTP",
    "description": "Verifies user using OTP and user ID. Marks user as verified if OTP is valid.",
    "tags": ["USER AUTH"],
    "requestBody": {
      "required": true,
      "content": {
        "application/json": {
          "schema": {
            "type": "object",
            "required": ["otp", "id"],
            "properties": {
              "otp": {
                "type": "string",
                "example": "123456"
              },
              "id": {
                "type": "string",
                "example": "uuid"
              }
            }
          }
        }
      }
    },
    "responses": {
      "200": {
        "description": "OTP Verified Successfully",
        "content": {
          "application/json": {
            "example": {
              "status": true,
              "message": "Verified successfully"
            }
          }
        }
      },
      "400": {
        "description": "Invalid OTP",
        "content": {
          "application/json": {
            "example": {
              "status": false,
              "message": "Invalid Otp"
            }
          }
        }
      },
      "401": {
        "description": "OTP Expired",
        "content": {
          "application/json": {
            "example": {
              "status": false,
              "message": "Otp Expired"
            }
          }
        }
      },
      "500": {
        "description": "Internal Server Error",
        "content": {
          "application/json": {
            "example": {
              "status": false,
              "message": "Something went wrong"
            }
          }
        }
      }
    }
  }
     },
    "/user/login": {
    "post": {
    "summary": "Login User",
    "description": "Logs in user using email and password. If user is not verified, OTP will be sent to email.",
    "tags": ["USER AUTH"],
    "requestBody": {
      "required": true,
      "content": {
        "application/json": {
          "schema": {
            "type": "object",
            "required": ["email", "password"],
            "properties": {
              "email": {
                "type": "string",
                "format": "email",
                "example": "ritesh@gmail.com"
              },
              "password": {
                "type": "string",
                "example": "123456"
              }
            }
          }
        }
      }
    },
    "responses": {
      "200": {
        "description": "Login Successful",
        "content": {
          "application/json": {
            "example": {
              "status": true,
              "message": "Login Successful",
              "Jwt_token": "your_jwt_token_here"
            }
          }
        }
      },
      "400": {
        "description": "User not found or incorrect password",
        "content": {
          "application/json": {
            "example": {
              "status": false,
              "message": "user not found"
            }
          }
        }
      },
      "401": {
        "description": "Incorrect Password",
        "content": {
          "application/json": {
            "example": {
              "status": false,
              "message": "Incorrect Password"
            }
          }
        }
      },
      "403": {
        "description": "User not verified - OTP sent",
        "content": {
          "application/json": {
            "example": {
              "status": false,
              "message": "Otp Send Successfully. Please verify your email before logging in."
            }
          }
        }
      },
      "500": {
        "description": "Internal Server Error",
        "content": {
          "application/json": {
            "example": {
              "status": false,
              "message": "Something went wrong"
            }
          }
        }
      }
    }
  }
     },
