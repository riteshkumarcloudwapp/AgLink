     "/user/resend-otp": {
    "post": {
    "summary": "Resend OTP",
    "description": "Resends OTP to user's email with rate limiting (60 seconds).",
    "tags": ["USER AUTH"],
    "requestBody": {
      "required": true,
      "content": {
        "application/json": {
          "schema": {
            "type": "object",
            "required": ["id"],
            "properties": {
              "id": {
                "type": "string",
                "example": "uuid"
              }
            }
          }
        }
      }
    },
    "responses": {
      "200": {
        "description": "OTP resent successfully",
        "content": {
          "application/json": {
            "example": {
              "status": true,
              "message": "Resend Otp Send"
            }
          }
        }
      },
      "400": {
        "description": "User not found or rate limit exceeded",
        "content": {
          "application/json": {
            "example": {
              "status": false,
              "message": "User not found"
            }
          }
        }
      },
      "429": {
        "description": "Too many requests (rate limit)",
        "content": {
          "application/json": {
            "example": {
              "status": false,
              "message": "Please wait 25 seconds before resending."
            }
          }
        }
      },
      "500": {
        "description": "Internal Server Error",
        "content": {
          "application/json": {
            "example": {
              "status": false,
              "message": "Something went wrong"
            }
          }
        }
      }
    }
  }
