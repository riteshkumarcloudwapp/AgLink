                  }
                ]
              }
             }
          }
        },
        "500": {
          "description": "Internal Server Error",
          "content": {
            "application/json": {
              "example": {
                "status": false,
                "message": "Something went wrong"
              }
            }
          }
        }
      }
    }
     },
     "/home/delete-category/{id}": {
