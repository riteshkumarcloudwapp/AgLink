              }
            }
          }
        },
        "400": {
          "description": "Category not found",
          "content": {
            "application/json": {
              "example": {
                "status": false,
                "message": "Category not found"
              }
            }
          }
        },
        "500": {
          "description": "Internal Server Error",
          "content": {
            "application/json": {
              "example": {
                "status": false,
                "message": "Something went wrong"
              }
            }
          }
        }
      }
    }
     }


    },



    "components": {
    "securitySchemes": {
        "BearerAuth": {
                "type": "http",
                "scheme": "bearer",
                "bearerFormat": "JWT"
            }
        }
    }
}